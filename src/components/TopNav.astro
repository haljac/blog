---
const currentPath = Astro.url.pathname;
---

<nav class="border-b border-gray-200 bg-white">
  <div class="max-w-4xl mx-auto px-6 py-4">
    <div class="flex items-center justify-between">
      <a href="/" class="text-xl font-medium text-gray-900 hover:text-gray-600 transition-colors">
        Hall's Notes
      </a>
      <div class="flex space-x-6">
        <a 
          href="/" 
          class={`text-gray-600 hover:text-gray-900 transition-colors ${currentPath === '/' ? 'text-gray-900' : ''}`}
        >
          Notes
        </a>
        <a 
          href="/about" 
          class={`text-gray-600 hover:text-gray-900 transition-colors ${currentPath === '/about' ? 'text-gray-900' : ''}`}
        >
          About
        </a>
      </div>
    </div>
  </div>
</nav>
