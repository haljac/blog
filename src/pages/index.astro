---
import Layout from '../layouts/Layout.astro';
import TopNav from '../components/TopNav.astro';
import { getCollection } from 'astro:content';

const notes = await getCollection('notes');
// Sort by date (newest first)
const sortedNotes = notes.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Layout 
  title="Hall's Notes" 
  description="A collection of thoughts and observations on technology, productivity, and life"
>
  <TopNav />
  <main class="max-w-4xl mx-auto px-6 py-8">
    <div class="space-y-8">
      <header class="mb-12">
        <h2 class="text-2xl font-light text-gray-900 mb-2">Notes</h2>
        <p class="text-gray-600">A collection of thoughts and observations</p>
      </header>
      
      <div class="space-y-6">
        {sortedNotes.map((note) => {
          const formattedDate = note.data.date.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric'
          });
          
          return (
            <article>
              <a 
                href={`/notes/${note.slug}`}
                class="block group cursor-pointer"
              >
                <div class="border-b border-gray-100 pb-6 group-hover:border-gray-200 transition-colors">
                  <div class="flex items-center justify-between mb-2">
                    <h3 class="text-lg font-medium text-gray-900 group-hover:text-gray-600 transition-colors">
                      {note.data.title}
                    </h3>
                    <time class="text-sm text-gray-500">{formattedDate}</time>
                  </div>
                  <p class="text-gray-600 leading-relaxed">{note.data.excerpt}</p>
                  {note.data.tags && note.data.tags.length > 0 && (
                    <div class="flex flex-wrap gap-2 mt-3">
                      {note.data.tags.slice(0, 3).map((tag) => (
                        <span class="px-2 py-1 bg-gray-100 text-gray-600 text-xs rounded">
                          {tag}
                        </span>
                      ))}
                    </div>
                  )}
                </div>
              </a>
            </article>
          );
        })}
      </div>
    </div>
  </main>
</Layout>
